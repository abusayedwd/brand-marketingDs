# Base API host (no trailing slash). RTK Query appends /v1

# Local development — point straight at the backend:
VITE_API_URL=http://localhost:3050

# Production (Vercel) — the deployed site is https, and browsers block a
# https page calling an http:// API ("mixed content"). So instead of the raw
# backend URL, use the relative path "/api" and let vercel.json proxy it
# server-side to the real backend (see the "rewrites" in vercel.json):
#
#   VITE_API_URL=/api
